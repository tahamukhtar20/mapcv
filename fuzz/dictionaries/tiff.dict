# TIFF / BigTIFF headers and the tags and codec ids src/geotiff reads.
# Byte orders and versions (classic 42, BigTIFF 43 with offset size 8)
header_le="II*\x00"
header_be="MM\x00*"
bigtiff_le="II+\x00\x08\x00\x00\x00"
bigtiff_be="MM\x00+\x00\x08\x00\x00"
# Tag ids, little-endian
t_new_subfile="\xfe\x00"
t_width="\x00\x01"
t_length="\x01\x01"
t_bits="\x02\x01"
t_compression="\x03\x01"
t_photometric="\x06\x01"
t_strip_offsets="\x11\x01"
t_samples="\x15\x01"
t_rows_per_strip="\x16\x01"
t_strip_counts="\x17\x01"
t_planar="\x1c\x01"
t_predictor="\x3d\x01"
t_tile_width="\x42\x01"
t_tile_length="\x43\x01"
t_tile_offsets="\x44\x01"
t_tile_counts="\x45\x01"
t_sample_format="\x53\x01"
t_jpeg_tables="\x5b\x01"
t_pixel_scale="\x0e\x83"
t_tiepoint="\x82\x84"
t_transformation="\xd8\x85"
t_geokeys="\xaf\x87"
t_geodoubles="\xb0\x87"
t_geoascii="\xb1\x87"
t_gdal_nodata="\x81\xa4"
# Compression codes, little-endian: LZW, JPEG, Deflate, PackBits, old Deflate, ZSTD, WebP
c_lzw="\x05\x00"
c_jpeg="\x07\x00"
c_deflate="\x08\x00"
c_packbits="\x05\x80"
c_old_deflate="\xb2\x80"
c_zstd="\x50\xc3"
c_webp="\x51\xc3"
# Field types: SHORT, LONG, DOUBLE, LONG8
f_short="\x03\x00"
f_long="\x04\x00"
f_double="\x0c\x00"
f_long8="\x10\x00"
# GeoKey directory header (version 1, revision 1.0) and common keys: model, raster, CRS codes
geo_header="\x01\x00\x01\x00\x00\x00"
k_model_type="\x01\x04\x00\x00\x01\x00"
k_raster_type="\x02\x04\x00\x00\x01\x00"
k_geographic="\x02\x08\x00\x00\x01\x00"
k_projected="\x0c\x0c\x00\x00\x01\x00"
user_defined="\xff\x7f"
epsg_4326="\xe6\x10"
epsg_3857="\x11\x0f"
# Codec stream starts: zlib, ZSTD frame, JPEG SOI/EOI, RIFF WebP
zlib="x\x9c"
zstd="\x28\xb5\x2f\xfd"
jpeg_soi="\xff\xd8\xff"
jpeg_eoi="\xff\xd9"
riff_webp="RIFF\x00\x00\x00\x00WEBP"
