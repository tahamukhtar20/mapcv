---
// Three-step "init → plan → generate" walkthrough for the landing page.
// Output is real `mapcv` 0.2.0 output from the Quickstart run, trimmed.
const steps = [
  {
    title: 'init',
    text: 'Answer four questions, or start from a template.',
    term: `<span class="p">$</span> <span class="c">mapcv init</span>
<span class="k">1/4 Imagery</span>
Imagery [esri/sentinel2/custom] (esri):
<span class="k">2/4 Area</span>
Area: buildings.geojson
<span class="d">Using the extent of 959 polygon(s)</span>
<span class="k">3/4 Labels</span> <span class="d">…</span> <span class="k">4/4 Patches and output</span> <span class="d">…</span>
<span class="g">✓</span> Wrote <span class="c">mapcv.yaml</span>`,
  },
  {
    title: 'plan',
    text: 'See tiles, patches, disk and memory before downloading anything.',
    term: `<span class="p">$</span> <span class="c">mapcv plan mapcv.yaml</span>
<span class="d">╭─ Plan for mapcv.yaml ─────────</span>
<span class="k">Imagery</span>  esri_satellite · zoom 17
         <span class="d">(≈ 0.73 m/px)</span>
<span class="k">Raster</span>   1,792 × 1,280 px · 35 tiles
<span class="k">Labels</span>   959 polygon(s)
<span class="k">Patches</span>  ≈ 35 × 256 px
<span class="k">Output</span>   dataset · png <span class="d">(≈ 3.9 MB)</span>`,
  },
  {
    title: 'generate',
    text: 'Fetch, rasterize, cut patches and split, with a summary at the end.',
    term: `<span class="p">$</span> <span class="c">mapcv generate mapcv.yaml</span>
<span class="d">Reading imagery and writing patches</span>
<span class="k">━━━━━━━━━━━━━━━━━━━━</span> 2/2 chunks
<span class="g">╭─ Dataset ready ───────────────</span>
<span class="g">Patches</span>  35
<span class="g">Shape</span>    256×256×3 uint8
<span class="g">Splits</span>   train 25 · val 3 · test 7
<span class="g">Time</span>     33s`,
  },
];
---

<div class="mapcv-steps not-content">
  {
    steps.map((step, index) => (
      <section class="mapcv-step">
        <header>
          <span>{index + 1}</span>
          <b>{step.title}</b>
        </header>
        <p>{step.text}</p>
        <pre class="mapcv-term" set:html={step.term} />
      </section>
    ))
  }
</div>
